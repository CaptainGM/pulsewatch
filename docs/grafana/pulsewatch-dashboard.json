{
  "title": "PulseWatch",
  "uid": "pulsewatch",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "datasource", "label": "Prometheus", "type": "datasource", "query": "prometheus" }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Çalışan API",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum(pulsewatch_monitor_up)" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Açık olay",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "pulsewatch_incidents_open" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime (24 saat, ortalama)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{ "refId": "A", "expr": "avg(pulsewatch_uptime_24h_percent)" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Kontrol sonucu (24 saat)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum by (result) (pulsewatch_checks_24h)", "legendFormat": "{{result}}" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Yanıt süresi (ms)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [{ "refId": "A", "expr": "pulsewatch_monitor_response_time_ms", "legendFormat": "{{monitor}}" }]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "HTTP durum kodları (24 saat)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum by (code) (pulsewatch_http_status_24h)", "legendFormat": "{{code}}" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Uptime yüzdesi (24 saat)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 90, "max": 100 } },
      "targets": [{ "refId": "A", "expr": "pulsewatch_uptime_24h_percent", "legendFormat": "{{monitor}}" }]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Bölge durumu (son kontrol)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "pulsewatch_region_up", "format": "table" }]
    }
  ]
}
