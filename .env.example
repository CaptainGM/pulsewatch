# Bu dosyayı .env adıyla kopyalayın: cp .env.example .env
# Üretimde ADMIN_PASSWORD ve JWT_SECRET değerlerini mutlaka değiştirin.

# Veritabanı (docker compose içindeki PostgreSQL için)
POSTGRES_PASSWORD=pulsewatch

# Giriş. AUTH_ENABLED=false yaparsanız panel şifresiz açılır.
AUTH_ENABLED=true
ADMIN_EMAIL=admin@pulsewatch.local
ADMIN_PASSWORD=pulsewatch
JWT_SECRET=change-me-in-production-pulsewatch-secret

# Web arayüzünün adresi ve dışarıya açılacak port
WEB_PORT=8080
FRONTEND_URL=http://localhost:8080
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Örnek veri (boş veritabanına bir kez eklenir)
SEED_DEMO=false

# Kontrol geçmişi kaç gün saklansın (0 = silme)
RETENTION_DAYS=30

# Kanal tanımlanmamışsa kullanılacak genel webhook (isteğe bağlı)
ALERT_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
